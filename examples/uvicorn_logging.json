{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {"events": {"format": "%(message)s"}},
  "handlers": {"console": {"class": "logging.StreamHandler", "formatter": "events", "stream": "ext://sys.stderr"}},
  "loggers": {
    "depi_ml": {"handlers": ["console"], "level": "INFO", "propagate": false},
    "uvicorn": {"handlers": ["console"], "level": "WARNING", "propagate": false},
    "uvicorn.access": {"handlers": [], "level": "WARNING", "propagate": false}
  }
}
