POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=depi-noshow-db
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME

DATASET_SCHEMA=analytics
DATASET_TABLE=appointment_training_dataset_v1
DATASET_EXPORT_DIR=data/exports
DATASET_BATCH_SIZE=10000

# FastAPI: lee solo variables exportadas del proceso, NO este .env de PostgreSQL.
# Demo deshabilitada por defecto. Configurar según docs/api_operations.md.
ML_API_ENV=development
ML_API_MODE=exploratory_demo
ML_ALLOW_EXPERIMENTAL_INFERENCE=false
ML_API_SERVICE_KEY=
ML_MODEL_REFERENCE_DIR=experiments/phase2-exploratory-prompt5-20261008
ML_MODEL_MANIFEST_SHA256=
ML_DEFAULT_MODEL_KEY=random_forest_full_v1
ML_MAX_REQUEST_BYTES=262144
ML_MAX_CONCURRENT_PREDICTIONS=2
ML_EXPOSE_DOCS=false
ML_ENABLE_LOCAL_EXPLANATIONS=false
ML_MAX_BATCH_ITEMS=32
